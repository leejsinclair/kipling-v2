#!/usr/bin/env sh

if ! command -v npm >/dev/null 2>&1; then
	export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

	if [ -s "$NVM_DIR/nvm.sh" ]; then
		. "$NVM_DIR/nvm.sh"
	elif [ -s "/usr/local/opt/nvm/nvm.sh" ]; then
		. "/usr/local/opt/nvm/nvm.sh"
	elif [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
		. "/opt/homebrew/opt/nvm/nvm.sh"
	fi
fi

if ! command -v npm >/dev/null 2>&1; then
	echo "Husky: npm not found. Ensure Node is installed and nvm is configured for non-interactive shells." >&2
	exit 127
fi

check_non_ts_stack_files() {
	staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
	blocked=$(printf "%s\n" "$staged_files" | grep -E '(^|/)(Gemfile|go\.mod|go\.sum|composer\.json|composer\.lock)$|\.(rb|go|php)$' || true)

	if [ -n "$blocked" ] && [ "${ALLOW_NON_TS_STACK:-0}" != "1" ]; then
		echo "✖ Guardrail: detected non-TypeScript stack files in staged changes:"
		printf "%s\n" "$blocked"
		echo "  If this is intentional, rerun with ALLOW_NON_TS_STACK=1"
		exit 1
	fi
}

check_non_ts_stack_files

npm run lint
